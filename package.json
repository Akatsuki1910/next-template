{
  "name": "next-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "npm run lint:eslint --quiet && npm run lint:stylelint --quiet",
    "lint:eslint": "eslint \"./**/*.?(ts|tsx|js)\"",
    "lint:eslint:fix": "npm run lint:eslint --fix",
    "lint:fix": "npm run lint:eslint:fix && npm run lint:stylelint:fix",
    "lint:stylelint": "stylelint '**/*.{css,scss}'",
    "lint:stylelint:fix": "npm run lint:stylelint --fix",
    "prettier": "prettier --write ./",
    "prettier:check": "prettier --check ./",
    "start": "next start"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.8",
    "ress": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-unicorn": "^73.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "yarn": "PLEASE USE NPM"
  }
}
